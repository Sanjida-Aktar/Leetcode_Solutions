
// Problem: Two Sum
// Link: https://leetcode.com/problems/two-sum/
// Approach: HashMap

class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        int n= nums.size();     //calculate the size of array

        for(int i=0; i<n; i++)
        {
            for(int j= i+1; j<n; j++)
            {
                if(nums[i]+ nums[j] == target)
                return [i,j];
            }
        }
        return {};
        
    }
};

